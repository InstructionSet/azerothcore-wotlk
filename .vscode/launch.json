{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Windows: Debug worldserver",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "D:/Data/AC/build/bin/RelWithDebInfo/worldserver.exe",
            "cwd": "D:/Data/AC/build/bin/RelWithDebInfo",
            "args": [],
            "environment": [],
            "externalConsole": true,
            "preLaunchTask": "AzerothCore: Build (Windows)"
        },
        {
            "name": "Windows: Debug authserver",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "D:/Data/AC/build/bin/RelWithDebInfo/authserver.exe",
            "cwd": "D:/Data/AC/build/bin/RelWithDebInfo",
            "args": [],
            "environment": [],
            "externalConsole": true
        },
        {
            "name": "Linux/Docker debug",
            "type": "cppdbg",
            "request": "launch",
            "program": "/azerothcore/env/dist/bin/worldserver",
            "cwd": "/azerothcore",
            "args": [],
            "environment": [],
            "externalConsole": false,
            "sourceFileMap": {
                "/azerothcore": "${workspaceFolder}"
            },
            "linux": {
                "MIMode": "gdb",
                "miDebuggerPath": "/usr/bin/gdb",
                "setupCommands": [
                    {
                        "description": "Enable pretty-printing for gdb",
                        "text": "-enable-pretty-printing",
                        "ignoreFailures": false
                    }
                ]
            }
        },
        {
            "name": "(docker run) Pipe Launch",
            "type": "cppdbg",
            "request": "launch",
            "program": "/azerothcore/env/dist/bin/worldserver",
            "cwd": "/azerothcore",
            "args": [],
            "environment": [],
            "externalConsole": true,
            "pipeTransport": {
                "debuggerPath": "/usr/bin/gdb",
                "pipeProgram": "docker compose",
                "pipeArgs": [
                    "exec", "-T", "ac-worldserver", "sh", "-c"
                ],
                "pipeCwd": "${workspaceFolder}"
            },
            "sourceFileMap": {
                "/azerothcore": "${workspaceFolder}"
            },
            "linux": {
                "MIMode": "gdb",
                "miDebuggerPath": "/usr/bin/gdb",
                "setupCommands": [
                    {
                        "description": "Enable pretty-printing for gdb",
                        "text": "-enable-pretty-printing",
                        "ignoreFailures": false
                    }
                ]
            },
            "osx": {
                "MIMode": "lldb"
            },
            "windows": {
                "MIMode": "gdb",
                "miDebuggerPath": "C:\\MinGw\\bin\\gdb.exe"
            }
        }
    ],
    "compounds": [
        {
            "name": "Windows: Launch authserver + worldserver",
            "configurations": [
                "Windows: Debug authserver",
                "Windows: Debug worldserver"
            ],
            "preLaunchTask": "AzerothCore: Build (Windows)"
        }
    ]
}
